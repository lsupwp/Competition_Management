APP_NAME=team_comp_app
APP_PORT=8000
APP_ENV=development
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Bangkok
APP_KEY=change-me-to-a-random-string
SESSION_TIMEOUT=1800
# Comma-separated IPs/CIDRs allowed to send X-Forwarded-For (real reverse proxy only)
TRUSTED_PROXIES=127.0.0.1,::1

# Keep DB_HOST=mariadb when using docker compose (ngrok only tunnels HTTP).
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=team_competition
DB_USERNAME=app_user
DB_PASSWORD=change-me-db-password
DB_ROOT_PASSWORD=change-me-root-password
DB_CONTAINER_NAME=team_comp_db
DB_EXTERNAL_PORT=3306

PMA_CONTAINER_NAME=team_comp_pma
PMA_EXTERNAL_PORT=8080

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=user@example.com
SMTP_PASSWORD=your-app-password
SMTP_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="Team Competition"
